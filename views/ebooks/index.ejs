<section class="container listing-page">
  <h1><%= lang === 'id' ? 'Ebook' : 'Ebooks' %></h1>

  <div class="filter-bar">
    <a href="/ebooks" class="<%= !activeCategory ? 'active' : '' %>"><%= lang === 'id' ? 'Semua' : 'All' %></a>
    <% categories.forEach(function (cat) { %>
      <a href="/ebooks?category=<%= cat.slug %>" class="<%= activeCategory === cat.slug ? 'active' : '' %>">
        <%= getLocalized(cat, 'name', lang) %>
      </a>
    <% }); %>
  </div>

  <% if (ebooks.length) { %>
    <div class="card-grid">
      <% ebooks.forEach(function (ebook) { %>
        <%- include('../partials/card', {
          heading: getLocalized(ebook, 'title', lang),
          excerpt: getLocalized(ebook, 'description', lang),
          image: ebook.coverImage,
          url: '/ebooks/' + ebook.slug
        }) %>
      <% }); %>
    </div>
  <% } else { %>
    <p class="empty-state"><%= lang === 'id' ? 'Belum ada ebook.' : 'No ebooks yet.' %></p>
  <% } %>
</section>
