<div class="admin-page-header">
  <h1><%= title %></h1>
  <div class="admin-row-actions">
    <% if (httpMethod === 'PUT') { %>
      <a href="/admin/ebooks/preview/<%= ebook.id %>" class="btn btn-secondary" target="_blank">Preview</a>
    <% } %>
    <a href="/admin/ebooks" class="btn btn-secondary">Back to Ebooks</a>
  </div>
</div>

<% if (errors && errors.length) { %>
  <div class="admin-error">
    <ul style="margin:0; padding-left: 1.1rem;">
      <% errors.forEach(function (err) { %><li><%= err %></li><% }); %>
    </ul>
  </div>
<% } %>

<form class="admin-form" method="POST" action="<%= formAction %>">
  <% if (httpMethod !== 'POST') { %>
    <input type="hidden" name="_method" value="<%= httpMethod %>">
  <% } %>

  <div class="form-row">
    <div class="form-group">
      <label for="slug">Slug</label>
      <input type="text" id="slug" name="slug" value="<%= ebook.slug || '' %>" placeholder="my-ebook-slug">
    </div>
    <div class="form-group">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">— None —</option>
        <% categories.forEach(function (cat) { %>
          <option value="<%= cat.slug %>" <%= ebook.category === cat.slug ? 'selected' : '' %>><%= cat.name_en %></option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="coverImage">Cover Image URL</label>
      <input type="url" id="coverImage" name="coverImage" value="<%= ebook.coverImage || '' %>" placeholder="https://..." data-image-preview="coverImage_preview">
      <img id="coverImage_preview" class="image-preview" alt="Cover image preview" style="display:none;">
    </div>
    <div class="form-group">
      <label for="tags">Tags (comma-separated)</label>
      <input type="text" id="tags" name="tags" value="<%= Array.isArray(ebook.tags) ? ebook.tags.join(', ') : (ebook.tags || '') %>">
    </div>
  </div>

  <div class="form-group">
    <label for="fileUrl">File URL (link to PDF)</label>
    <input type="url" id="fileUrl" name="fileUrl" value="<%= ebook.fileUrl || '' %>" placeholder="https://drive.google.com/...">
    <input type="hidden" name="fileType" value="link">
    <p class="form-hint">Direct file uploads land in a later stage — for now, paste a link (e.g. Google Drive).</p>
  </div>

  <div class="lang-tabs" data-lang-tabs>
    <div class="lang-tab-buttons">
      <button type="button" class="lang-tab-btn active" data-lang-tab-btn="en">English</button>
      <button type="button" class="lang-tab-btn" data-lang-tab-btn="id">Indonesian</button>
    </div>

    <div class="lang-tab-panel" data-lang-tab-panel="en">
      <div class="form-group">
        <label for="title_en">Title (EN)</label>
        <input type="text" id="title_en" name="title_en" value="<%= ebook.title_en || '' %>">
      </div>
      <div class="form-group">
        <label>Description (EN)</label>
        <div class="quill-editor" data-quill-for="description_en_input"><%- ebook.description_en || '' %></div>
        <input type="hidden" name="description_en" id="description_en_input">
      </div>
    </div>

    <div class="lang-tab-panel" data-lang-tab-panel="id" style="display:none;">
      <div class="form-group">
        <label for="title_id">Title (ID)</label>
        <input type="text" id="title_id" name="title_id" value="<%= ebook.title_id || '' %>">
      </div>
      <div class="form-group">
        <label>Description (ID)</label>
        <div class="quill-editor" data-quill-for="description_id_input"><%- ebook.description_id || '' %></div>
        <input type="hidden" name="description_id" id="description_id_input">
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group form-check">
      <input type="checkbox" id="published" name="published" <%= ebook.published ? 'checked' : '' %>>
      <label for="published">Published</label>
    </div>
    <div class="form-group form-check">
      <input type="checkbox" id="gated" name="gated" <%= ebook.gated ? 'checked' : '' %>>
      <label for="gated">Require email to download</label>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/admin/ebooks" class="btn btn-secondary">Cancel</a>
  </div>
</form>
