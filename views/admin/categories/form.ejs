<div class="admin-page-header">
  <h1><%= title %></h1>
  <a href="/admin/categories" class="btn btn-secondary">Back to Categories</a>
</div>

<% if (errors && errors.length) { %>
  <div class="admin-error">
    <ul style="margin:0; padding-left: 1.1rem;">
      <% errors.forEach(function (err) { %><li><%= err %></li><% }); %>
    </ul>
  </div>
<% } %>

<form class="admin-form" method="POST" action="<%= formAction %>">
  <% if (httpMethod !== 'POST') { %>
    <input type="hidden" name="_method" value="<%= httpMethod %>">
  <% } %>

  <div class="form-group">
    <label for="slug">Slug</label>
    <input type="text" id="slug" name="slug" value="<%= category.slug || '' %>" placeholder="islamic-anthropology">
  </div>

  <div class="lang-tabs" data-lang-tabs>
    <div class="lang-tab-buttons">
      <button type="button" class="lang-tab-btn active" data-lang-tab-btn="en">English</button>
      <button type="button" class="lang-tab-btn" data-lang-tab-btn="id">Indonesian</button>
    </div>

    <div class="lang-tab-panel" data-lang-tab-panel="en">
      <div class="form-group">
        <label for="name_en">Name (EN)</label>
        <input type="text" id="name_en" name="name_en" value="<%= category.name_en || '' %>">
      </div>
      <div class="form-group">
        <label for="description_en">Description (EN)</label>
        <textarea id="description_en" name="description_en"><%= category.description_en || '' %></textarea>
      </div>
    </div>

    <div class="lang-tab-panel" data-lang-tab-panel="id" style="display:none;">
      <div class="form-group">
        <label for="name_id">Name (ID)</label>
        <input type="text" id="name_id" name="name_id" value="<%= category.name_id || '' %>">
      </div>
      <div class="form-group">
        <label for="description_id">Description (ID)</label>
        <textarea id="description_id" name="description_id"><%= category.description_id || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/admin/categories" class="btn btn-secondary">Cancel</a>
  </div>
</form>
