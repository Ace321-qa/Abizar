<section class="hero container">
  <h1><%= siteName[lang] %></h1>
  <p class="tagline">
    <%= lang === 'id'
      ? 'Esai, ebook, video, dan audio seputar antropologi Islam dan kesehatan masyarakat.'
      : 'Essays, ebooks, videos, and audio on Islamic anthropology and public health.' %>
  </p>
</section>

<section class="container home-section">
  <div class="section-header">
    <h2><%= lang === 'id' ? 'Esai Terbaru' : 'Recent Articles' %></h2>
    <a href="/articles"><%= lang === 'id' ? 'Lihat semua' : 'View all' %></a>
  </div>
  <% if (articles.length) { %>
    <div class="card-grid">
      <% articles.forEach(function(article) { %>
        <%- include('partials/card', {
          heading: getLocalized(article, 'title', lang),
          excerpt: getLocalized(article, 'excerpt', lang),
          image: article.coverImage,
          url: '/articles/' + article.slug
        }) %>
      <% }); %>
    </div>
  <% } else { %>
    <p class="empty-state"><%= lang === 'id' ? 'Belum ada esai.' : 'No articles yet.' %></p>
  <% } %>
</section>

