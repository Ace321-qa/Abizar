<article class="container article-show">
  <% if (getCategoryName(article.category, lang)) { %>
    <span class="card-eyebrow"><%= getCategoryName(article.category, lang) %></span>
  <% } %>
  <h1><%= getLocalized(article, 'title', lang) %></h1>
  <p class="meta">
    <%= new Date(article.createdAt).toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
    <% if (getLocalized(article, 'readingTime', lang)) { %>
      &middot; <%= getLocalized(article, 'readingTime', lang) %>
    <% } %>
  </p>
  <% if (article.coverImage) { %>
    <img src="<%= article.coverImage %>" alt="<%= getLocalized(article, 'title', lang) %>" class="article-cover">
  <% } %>
  <div class="prose"><%- getLocalized(article, 'content', lang) %></div>

  <%- include('../partials/shareButtons', {
    shareTitle: getLocalized(article, 'title', lang),
    shareUrl: shareUrl
  }) %>
</article>
